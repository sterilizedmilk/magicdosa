<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>magicdosa</groupId>
  <artifactId>magicdosa-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>magicdosa</name>

  <modules>
    <module>protocol</module>
    <module>adapter/forge</module>
    <module>agent-core</module>
    <module>runner/forge</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Forge = the forge submodule (pinned commit), installed to the local repo by scripts/install-forge.ps1 -->
    <forge.version>2.0.16-SNAPSHOT</forge.version>
    <protobuf.version>4.28.3</protobuf.version>
    <!-- adapter <-> agent-core transport (session.proto service AgentCore) -->
    <grpc.version>1.68.1</grpc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>magicdosa</groupId>
        <artifactId>magicdosa-protocol</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>magicdosa</groupId>
        <artifactId>magicdosa-agent-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>magicdosa</groupId>
        <artifactId>magicdosa-adapter-forge</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>forge</groupId>
        <artifactId>forge-gui-desktop</artifactId>
        <version>${forge.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <!-- Forge's version (forge-core/pom.xml); grpc would otherwise pull an older one in -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>33.3.1-android</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <compilerArgs><arg>-nowarn</arg></compilerArgs>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
