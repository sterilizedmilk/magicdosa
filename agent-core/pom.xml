<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>magicdosa</groupId>
    <artifactId>magicdosa-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>magicdosa-agent-core</artifactId>
  <description>Search, inference, shadow game (embedded Forge)</description>
  <properties>
    <!-- the forge submodule; Forge reads res/ from forge-gui -->
    <forge.home>${project.basedir}/../forge</forge.home>
    <!-- harnesses and benchmarks are main programs in the test sources, so mvn install does not run them -->
    <exec.mainClass>magicdosa.agent.determinism.ParallelDeterminismHarness</exec.mainClass>
    <decks.dir>${project.basedir}/../decks</decks.dir>
    <!-- paths in exec.args must be absolute: the JVM runs in forge-gui -->
    <exec.args>${decks.dir} IzzetProwess.dck EsperBlink.dck 40 8 5000</exec.args>
    <jvm.args>-Xmx3g -Dfile.encoding=UTF-8</jvm.args>
  </properties>
  <dependencies>
    <dependency>
      <groupId>magicdosa</groupId>
      <artifactId>magicdosa-protocol</artifactId>
    </dependency>
    <!-- Forge <-> protocol library: GameCreation, observations, entity IDs, events (shadow game) -->
    <dependency>
      <groupId>magicdosa</groupId>
      <artifactId>magicdosa-adapter-forge</artifactId>
    </dependency>
    <dependency>
      <groupId>forge</groupId>
      <artifactId>forge-gui-desktop</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
    </dependency>
    <!-- training shards (encoder E5): Arrow IPC files -->
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-vector</artifactId>
      <version>17.0.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-unsafe</artifactId>
      <version>17.0.0</version>
    </dependency>
    <!-- network inference (design: "추론 위치": agent-core runs the model with ONNX Runtime, CPU). 1.20.0 is the newest
         release that runs on this PC's JDKs: later ones need a newer msvcp140.dll than the one the JDK loads at startup
         (Corretto 17 ships 14.16; 1.31 crashes in it, 1.21 and 1.22 exit at load). Models need IR version 10 or lower. -->
    <dependency>
      <groupId>com.microsoft.onnxruntime</groupId>
      <artifactId>onnxruntime</artifactId>
      <version>1.20.0</version>
    </dependency>
    <!-- shards' buffer compression (zstd, same format as Arrow's arrow-compression module) -->
    <dependency>
      <groupId>com.github.luben</groupId>
      <artifactId>zstd-jni</artifactId>
      <version>1.5.5-11</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-inprocess</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- shadow scenario tests run Forge, which reads res/ from forge-gui -->
          <workingDirectory>${forge.home}/forge-gui</workingDirectory>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <executable>java</executable>
          <classpathScope>test</classpathScope>
          <workingDirectory>${forge.home}/forge-gui</workingDirectory>
          <commandlineArgs>${jvm.args} -classpath %classpath ${exec.mainClass} ${exec.args}</commandlineArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
